{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vite in Brave",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "Start Vite if needed",
      "url": "http://localhost:5173/wordle/",
      "webRoot": "${workspaceFolder}/src",
      "runtimeExecutable": "/usr/bin/brave",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--no-first-run",
        "--no-default-browser-check"
      ]
    },
  ]
}
